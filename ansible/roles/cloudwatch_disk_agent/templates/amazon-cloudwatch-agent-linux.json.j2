{
  "agent": {
    "metrics_collection_interval": {{ cw_metric_collection_interval_seconds }},
    "run_as_user": "root"
  },
  "metrics": {
    "namespace": {{ cw_namespace | to_json }},
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "aggregation_dimensions": [["InstanceId", "path"]],
    "metrics_collected": {
      "disk": {
        "measurement": [
          {"name": "used_percent", "rename": {{ linux_disk_metric_name | to_json }}, "unit": "Percent"}
        ],
        "resources": ["*"],
        "drop_original_metrics": ["disk_used_percent"],
        "ignore_file_system_types": {{ linux_ignored_filesystems | to_json }}
      }
    }
  }
}
