{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssumeMemberExecutionRoles",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": [
        "arn:aws:iam::111122223333:role/AnsibleCrossAccountExecutionRole",
        "arn:aws:iam::444455556666:role/AnsibleCrossAccountExecutionRole"
      ]
    },
    {
      "Sid": "PublishCoverageReports",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": [
        "arn:aws:sns:us-east-1:123456789012:enterprise-disk-alerts",
        "arn:aws:sns:us-west-2:123456789012:enterprise-disk-alerts"
      ]
    }
  ]
}
